  "about": {
    "paragraph1": "The ability of railway operators to respond to snow and ice weather conditions has become an issue with industry stakeholders over the past few years.",
    "paragraph2": "UMBRELLA OS integration constitutes a sophisticated and intelligent rail energy management system that complements our customer's existing network.",
    "features": {
      "auditTrail": {
        "title": "Full Audit Trail & Traceability",
        "description": "Provides a connection report as well as the ability to track and verify all settings and actions."
      },
      "vantagePoint": {
        "title": "Vantage Point",
        "description": "Direct live remote access to monitor and control all platform functions from any location."
      },
      "firewall": {
        "title": "Firewall Friendly",
        "description": "uses an outbound connection that does not require modification to your network firewall or router."
      },
      "security": {
        "title": "Security & Control",
        "description": "A fully secure SSL-based connection that is both reliable and safe. You control who has access."
      },
      "communication": {
        "title": "Communication Made Easy",
        "description": "The administrator remotely connects to monitor systems, and manage."
      },
      "connectivity": {
        "title": "Integrated WiFi & Cellular Connectivity",
        "description": "WiFi and cellular capable for establishing a highly reliable connection for monitoring and control."
      }
    }
  },
